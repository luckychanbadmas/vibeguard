# ===================================================
# VibeGuard Environment Configuration
# ===================================================

# Database Connection URI (PostgreSQL in production/Docker, or SQLite file:./dev.db for zero-config local dev)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://vibeguard:vibeguard_secure_pwd@localhost:5432/vibeguard?schema=public"

# Redis Connection URL (for BullMQ job processing)
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="vibeguard-cyberpunk-super-secret-key-32chars-min"

# Optional GitHub OAuth Credentials for developer sign-in
GITHUB_ID=""
GITHUB_SECRET=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scanner Engine Security & Safety Controls
# Maximum non-destructive requests per second per target scan (default: 5)
SCAN_RATE_LIMIT_RPS=5

# Maximum total requests executed across all modules for a single scan job (default: 200)
SCAN_MAX_REQUESTS=200

# Demo Mode: Enable to load pre-seeded vibe-code scans and bypass external DNS checks for local testing
DEMO_MODE=true
